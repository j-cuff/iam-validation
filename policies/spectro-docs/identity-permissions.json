{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EKSPodIdentityManagement",
      "Effect": "Allow",
      "Action": [
        "eks:ListPodIdentityAssociations",
        "eks:CreatePodIdentityAssociation",
        "eks:DeletePodIdentityAssociation"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "EC2",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "IAM",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole"
      ],
      "Resource": [
        "arn:<partition>:iam::<aws-account-id>:role/<role-name-for-palette-iam-role>"
      ]
    },
    {
      "Sid": "IAMPassRoleforPodIdentity",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:<partition>:iam::<aws-account-id>:role/<role-name-for-palette-iam-role>"
      ]
    }
  ]
}
