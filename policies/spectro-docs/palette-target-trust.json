{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:<partition>:iam::<aws-management-cluster-account-id>:role/<role-name-for-identity-service-iam-local-role>"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "<aws-management-cluster-region>/<aws-management-cluster-account-id>/<management-cluster-name>/palette-identity/palette-identity"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:<partition>:iam::<aws-management-cluster-account-id>:role/<role-name-for-identity-service-iam-local-role>"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringLike": {
          "sts:ExternalId": "<aws-management-cluster-region>/<aws-management-cluster-account-id>/<management-cluster-name>/*/palette-manager"
        }
      }
    },
    {
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:<partition>:iam::<aws-management-cluster-account-id>:role/<role-name-for-identity-service-iam-local-role>"
      },
      "Action": "sts:TagSession"
    },
    {
      "Sid": "AllowEksAuthToAssumeRoleForPodIdentity",
      "Effect": "Allow",
      "Principal": {
        "Service": "pods.eks.amazonaws.com"
      },
      "Action": [
        "sts:AssumeRole",
        "sts:TagSession"
      ]
    }
  ]
}
